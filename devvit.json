{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "small-detour",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html",
        "height": "regular"
      },
      "game": {
        "entry": "index.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "reddit": true,
    "redis": true
  },
  "scheduler": {
    "tasks": {
      "daily-reminders": {
        "endpoint": "/internal/scheduler/daily-reminders",
        "cron": "* * * * *"
      }
    }
  },
  "menu": {
    "items": [
      {
        "label": "Create today's One Small Detour",
        "description": "Create a daily game post. This publishes a post only when you choose this action.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-detour"
      }
    ]
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "dev": {
    "subreddit": "small_detour_dev"
  }
}